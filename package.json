{
  "name": "feathers-trigger",
  "version": "4.0.1",
  "description": "Add triggers and actions to your feathers app.",
  "author": "fratzinger",
  "homepage": "https://feathers-trigger.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/fratzinger/feathers-trigger"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "feathers",
    "feathers.js",
    "feathers-plugin",
    "trigger",
    "actions",
    "notify",
    "notification"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**"
  ],
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "tsdown",
    "version": "npm run build",
    "release": "np",
    "test": "vitest run",
    "vitest": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "dequal": "^2.0.3",
    "feathers-utils": "^10.8.2",
    "sift": "^17.1.3"
  },
  "devDependencies": {
    "@feathers-community/eslint-config": "^0.3.0",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/memory": "^5.0.50",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "feathers-graph-populate": "^6.0.1",
    "np": "^12.1.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@feathersjs/feathers": "^5.0.0"
  }
}
